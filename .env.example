# Copy to .env for local use, or set these on the host. Never commit a real .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# HTTPS webhook that receives validated contact submissions as JSON.
# If unset, the form cannot deliver messages and offers the visitor's email app instead.
CONTACT_WEBHOOK_URL=

# 1 when running behind a proxy / load balancer (so rate limiting sees the real client IP).
TRUST_PROXY=0

# Build time only (npm run build): absolute URL used for canonical links and the share image.
SITE_URL=https://demazetech.com
